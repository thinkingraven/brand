{
  "$description": "Thinking Raven design tokens, v2 (Night Watch), in W3C design-tokens format. Mirrors the YAML front matter of DESIGN.md, which is the source of truth.",
  "color": {
    "primary":               { "$type": "color", "$value": "#F2A93B", "$description": "Thought amber. One primary action per view, the wordmark full stop, the thinking indicator, and one signal band plus one closing band per page." },
    "primary-active":        { "$type": "color", "$value": "#D98F22" },
    "primary-disabled":      { "$type": "color", "$value": "#E9E3D6" },
    "on-primary":            { "$type": "color", "$value": "#0F0F14", "$description": "Text on amber is always ink, never white." },
    "ink":                   { "$type": "color", "$value": "#0F0F14" },
    "body-strong":           { "$type": "color", "$value": "#1A1A21" },
    "body":                  { "$type": "color", "$value": "#2B2B33" },
    "muted":                 { "$type": "color", "$value": "#5C5C68" },
    "muted-soft":            { "$type": "color", "$value": "#6A6A75", "$description": "Lowest allowed text tone on bone (4.65:1)." },
    "hairline":              { "$type": "color", "$value": "#E3DDD0" },
    "hairline-soft":         { "$type": "color", "$value": "#EEE8DC" },
    "canvas":                { "$type": "color", "$value": "#F3EFE6", "$description": "Bone. The page floor in the light theme; marketing pages default to the dark theme (ink)." },
    "surface-soft":          { "$type": "color", "$value": "#FAF8F3" },
    "surface-card":          { "$type": "color", "$value": "#FFFFFF" },
    "surface-strong":        { "$type": "color", "$value": "#E9E3D6" },
    "surface-dark":          { "$type": "color", "$value": "#0F0F14" },
    "surface-dark-elevated": { "$type": "color", "$value": "#15151B" },
    "surface-dark-soft":     { "$type": "color", "$value": "#1B1B22" },
    "hairline-dark":         { "$type": "color", "$value": "#2A2A33" },
    "surface-deep":          { "$type": "color", "$value": "#0A0A0E", "$description": "Sitemap footer. Same in both themes." },
    "on-dark":               { "$type": "color", "$value": "#F3EFE6" },
    "on-dark-soft":          { "$type": "color", "$value": "#9A9AA8" },
    "on-dark-muted":         { "$type": "color", "$value": "#8A8A98" },
    "success":               { "$type": "color", "$value": "#256B43" },
    "success-on-dark":       { "$type": "color", "$value": "#7BD88F" },
    "success-soft":          { "$type": "color", "$value": "#E3EFE6" },
    "warning":               { "$type": "color", "$value": "#8A5A00" },
    "warning-on-dark":       { "$type": "color", "$value": "#F2A93B" },
    "warning-soft":          { "$type": "color", "$value": "#F8EBD3" },
    "error":                 { "$type": "color", "$value": "#B42318" },
    "error-on-dark":         { "$type": "color", "$value": "#FF7B72" },
    "error-soft":            { "$type": "color", "$value": "#F7E1DE" },
    "info":                  { "$type": "color", "$value": "#2F5FA8" },
    "info-on-dark":          { "$type": "color", "$value": "#8AB4F8" },
    "info-soft":             { "$type": "color", "$value": "#E1E9F5" },
    "focus-ring-light":      { "$type": "color", "$value": "#0F0F14", "$description": "Amber on bone is 1.7:1, so focus on light surfaces is ink." },
    "focus-ring-dark":       { "$type": "color", "$value": "#F2A93B" }
  },
  "contrast": {
    "ink-on-canvas": 16.7, "body-on-canvas": 12.2, "muted-on-canvas": 5.7, "muted-soft-on-canvas": 4.65,
    "on-dark-on-ink": 16.7, "on-dark-soft-on-ink": 6.9, "on-dark-muted-on-ink": 5.6,
    "ink-on-primary": 9.6, "ink-on-primary-active": 7.2, "amber-on-canvas": 1.7
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Space Grotesk", "Helvetica Neue", "Arial", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["Space Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
  },
  "typography": {
    "display-xl":  { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "96px", "fontWeight": 500, "lineHeight": 1, "letterSpacing": "-0.045em" } },
    "display-lg":  { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "64px", "fontWeight": 500, "lineHeight": 1.02, "letterSpacing": "-0.04em" } },
    "display-md":  { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "44px", "fontWeight": 500, "lineHeight": 1.05, "letterSpacing": "-0.03em" } },
    "display-sm":  { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "30px", "fontWeight": 500, "lineHeight": 1.15, "letterSpacing": "-0.02em" } },
    "title-lg":    { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "22px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "-0.2px" } },
    "title-md":    { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "18px", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "-0.1px" } },
    "title-sm":    { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "16px", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "0" } },
    "body-lg":     { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "18px", "fontWeight": 400, "lineHeight": 1.6, "letterSpacing": "0" } },
    "body-md":     { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.6, "letterSpacing": "0" } },
    "body-sm":     { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.55, "letterSpacing": "0" } },
    "caption":     { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "13px", "fontWeight": 500, "lineHeight": 1.4, "letterSpacing": "0" } },
    "kicker":      { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontSize": "12px", "fontWeight": 700, "lineHeight": 1.4, "letterSpacing": "1.8px", "textTransform": "uppercase" } },
    "code":        { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.6, "letterSpacing": "0" } },
    "button":      { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "14px", "fontWeight": 600, "lineHeight": 1, "letterSpacing": "0" } },
    "nav-link":    { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "14px", "fontWeight": 500, "lineHeight": 1.4, "letterSpacing": "0" } }
  },
  "wordmark": {
    "$description": "\"thinking\" (400) + 0.30em word space + \"raven\" (700), lowercase, tracking -0.03em, amber full stop. Use the outlined SVGs in logos/final; never retype it or close the space.",
    "word-space": { "$type": "dimension", "$value": "0.30em" },
    "tracking":   { "$type": "dimension", "$value": "-0.03em" }
  },
  "rounded": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "18px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "9999px" },
    "full": { "$type": "dimension", "$value": "50%" }
  },
  "spacing": {
    "xxs": { "$type": "dimension", "$value": "4px" },
    "xs": { "$type": "dimension", "$value": "8px" },
    "sm": { "$type": "dimension", "$value": "12px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" },
    "xxl": { "$type": "dimension", "$value": "48px" },
    "xxxl": { "$type": "dimension", "$value": "64px" },
    "section": { "$type": "dimension", "$value": "72px" },
    "section-lg": { "$type": "dimension", "$value": "96px" },
    "container": { "$type": "dimension", "$value": "1120px" },
    "gutter": { "$type": "dimension", "$value": "16px" },
    "gutter-lg": { "$type": "dimension", "$value": "28px" },
    "frame": { "$type": "dimension", "$value": "1200px", "$description": "Framed grid: the centred column with a 1px rail on each side." },
    "frame-padding": { "$type": "dimension", "$value": "40px", "$description": "Side padding inside the frame (16px on mobile)." }
  },
  "elevation": {
    "none": { "$type": "shadow", "$value": "none" },
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(15,15,20,0.06)" },
    "md": { "$type": "shadow", "$value": "0 8px 24px rgba(15,15,20,0.10)" },
    "lg": { "$type": "shadow", "$value": "0 24px 64px rgba(15,15,20,0.18)" },
    "focus-light": { "$type": "shadow", "$value": "0 0 0 2px #F3EFE6, 0 0 0 4px #0F0F14" },
    "focus-dark": { "$type": "shadow", "$value": "0 0 0 2px #0F0F14, 0 0 0 4px #F2A93B" }
  },
  "motion": {
    "duration-fast": { "$type": "duration", "$value": "120ms" },
    "duration-base": { "$type": "duration", "$value": "200ms" },
    "duration-slow": { "$type": "duration", "$value": "320ms" },
    "duration-thinking": { "$type": "duration", "$value": "1200ms" },
    "easing-standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
    "easing-enter": { "$type": "cubicBezier", "$value": [0, 0, 0, 1] },
    "easing-exit": { "$type": "cubicBezier", "$value": [0.3, 0, 1, 1] }
  },
  "breakpoint": {
    "mobile-max": { "$type": "dimension", "$value": "639px" },
    "tablet": { "$type": "dimension", "$value": "640px" },
    "nav-expand": { "$type": "dimension", "$value": "900px" },
    "desktop": { "$type": "dimension", "$value": "1024px" },
    "wide": { "$type": "dimension", "$value": "1440px" }
  },
  "theme-dark": {
    "$description": "Role remapping for dark mode (implemented in tokens.css).",
    "canvas": { "$type": "color", "$value": "#0F0F14" },
    "surface-card": { "$type": "color", "$value": "#15151B" },
    "surface-soft": { "$type": "color", "$value": "#121217" },
    "surface-strong": { "$type": "color", "$value": "#1B1B22" },
    "hairline": { "$type": "color", "$value": "#2A2A33" },
    "ink": { "$type": "color", "$value": "#F3EFE6" },
    "body": { "$type": "color", "$value": "#D9D5CC" },
    "muted": { "$type": "color", "$value": "#9A9AA8" },
    "muted-soft": { "$type": "color", "$value": "#8A8A98" }
  }
}
